# Copy to .env in the repo root (or wherever you run `slackchat` from) and
# fill in real values. `.env` is gitignored; nothing here should ever be
# committed with a real secret in it.
#
# Loaded once, at the top of `slackchat` (cli/main.py:main). Only fills in
# variables that are not already set in the environment — a real shell
# export always wins over this file.

# Required: the Anthropic API key. Never put this in config.toml.
ANTHROPIC_API_KEY=

# Optional overrides; see config.example.toml for their config.toml
# equivalents and defaults.
# SLACKCHAT_CONFIG=/path/to/config.toml
# SLACKCHAT_DB=/path/to/runs.db
# SLACKCHAT_SERVER_TOKEN=some-shared-secret
