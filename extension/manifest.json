{
  "manifest_version": 3,
  "name": "slackchat",
  "version": "0.1.0",
  "description": "Send the Slack message box to the local slackchat daemon and apply the result.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://app.slack.com/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://app.slack.com/*"],
      "js": ["lib/result.js", "content.js"]
    }
  ]
}
